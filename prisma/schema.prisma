generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Clinic {
  id            String   @id @default(cuid())
  name          String
  phone         String?
  address       String?
  workingHoursStart String @default("08:00")
  workingHoursEnd   String @default("18:00")
  slotDuration  Int      @default(30)
  workingDays   String   @default("1,2,3,4,5")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users         User[]
  patients      Patient[]
  services      Service[]
  appointments  Appointment[]
  leads         CommercialLead[]
  treatments    Treatment[]
  transactions  Transaction[]
}

model User {
  id            String   @id @default(cuid())
  clinicId      String
  name          String
  email         String   @unique
  passwordHash  String
  role          String   @default("owner")
  isSuperAdmin  Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  clinic        Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointments  Appointment[]

  @@index([clinicId])
}

model Patient {
  id            String   @id @default(cuid())
  clinicId      String
  name          String
  cpf           String?
  birthDate     DateTime?
  phone         String
  email         String?
  address       String?
  insurance     String?
  notes         String?
  avatarUrl     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  clinic        Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointments  Appointment[]
  leads         CommercialLead[]
  treatments    Treatment[]
  transactions  Transaction[]

  @@index([clinicId])
  @@index([clinicId, name])
}

model Service {
  id              String   @id @default(cuid())
  clinicId        String
  name            String
  description     String?
  category        String
  price           Float
  durationMinutes Int
  defaultSessions Int      @default(1)
  color           String   @default("#3b82f6")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  clinic          Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointments    Appointment[]
  leads           CommercialLead[]
  treatments      Treatment[]
  transactions    Transaction[]

  @@index([clinicId])
}

model Appointment {
  id            String   @id @default(cuid())
  clinicId      String
  patientId     String
  serviceId     String
  userId        String
  treatmentId   String?
  startTime     DateTime
  endTime       DateTime
  status        String   @default("scheduled")
  notes         String?
  priceOverride Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  clinic        Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient       Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  service       Service   @relation(fields: [serviceId], references: [id])
  user          User      @relation(fields: [userId], references: [id])
  treatment     Treatment? @relation(fields: [treatmentId], references: [id])
  transactions  Transaction[]

  @@index([clinicId])
  @@index([clinicId, startTime])
}

model CommercialLead {
  id              String   @id @default(cuid())
  clinicId        String
  patientId       String?
  name            String
  phone           String
  serviceInterest String?
  serviceId       String?
  budgetValue     Float?
  stage           String   @default("new")
  lostReason      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  clinic          Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient         Patient? @relation(fields: [patientId], references: [id])
  service         Service? @relation(fields: [serviceId], references: [id])

  @@index([clinicId])
  @@index([clinicId, stage])
}

model Treatment {
  id                String   @id @default(cuid())
  clinicId          String
  patientId         String
  serviceId         String
  totalSessions     Int
  completedSessions Int      @default(0)
  totalPrice        Float
  stage             String   @default("scheduled")
  returnDate        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  clinic            Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient           Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  service           Service  @relation(fields: [serviceId], references: [id])
  appointments      Appointment[]
  transactions      Transaction[]

  @@index([clinicId])
  @@index([clinicId, stage])
}

model Transaction {
  id            String   @id @default(cuid())
  clinicId      String
  patientId     String
  appointmentId String?
  treatmentId   String?
  serviceId     String
  amount        Float
  status        String   @default("pending")
  paymentMethod String?
  paidAt        DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  clinic        Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient       Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  treatment     Treatment?  @relation(fields: [treatmentId], references: [id])
  service       Service     @relation(fields: [serviceId], references: [id])

  @@index([clinicId])
  @@index([clinicId, status])
  @@index([clinicId, createdAt])
}
